{
	"name": "bridgette-scoreboard-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"quality:all": "pnpm run format:check && pnpm run lint && pnpm run knip && node scripts/quality.mjs quality --all && pnpm run check && pnpm run test && pnpm run build",
		"dev": "pnpm --dir config run dev",
		"build": "pnpm --dir config run build",
		"check": "pnpm --dir config run check",
		"format": "pnpm --dir config run format",
		"format:check": "pnpm --dir config run format:check",
		"lint": "pnpm --dir config run lint",
		"knip": "pnpm --dir config run knip",
		"quality": "node scripts/quality.mjs",
		"test": "pnpm --dir config run test"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.4",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@terra-symposium/standards-error-boundaries": "^0.1.2",
		"astro": "^7.4.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"sonner": "^2.0.8",
		"tailwind-merge": "^2.6.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@eslint/js": "^9",
		"@headlessui/tailwindcss": "^0.2.2",
		"@tailwindcss/typography": "^0.5.20",
		"@terra-symposium/standards-quality": "2.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.18",
		"autoprefixer": "^10.5.4",
		"eslint": "^9",
		"eslint-plugin-astro": "^1.3.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^16.4.0",
		"knip": "^6.45.1",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^1.1.1",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-scrim-gradients": "^0.4.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vidstack": "^0.4.5"
	},
	"pnpm": {
		"overrides": {
			"d3-color": "3.1.0",
			"postcss-selector-parser": "6.1.5",
			"source-map-js": "1.2.2",
			"vite": "8.3.3"
		}
	}
}
