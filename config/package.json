{
	"name": "bridgette-scoreboard",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "cd .. && astro dev --config config/astro.config.mjs",
		"build": "cd .. && astro build --config config/astro.config.mjs",
		"check": "cd .. && astro check --config config/astro.config.mjs --tsconfig config/tsconfig.json",
		"format": "cd .. && prettier --config config/.prettierrc.mjs --ignore-path config/.prettierignore --write .",
		"format:check": "cd .. && prettier --config config/.prettierrc.mjs --ignore-path config/.prettierignore --check .",
		"lint": "cd .. && eslint --config config/eslint.config.mjs .",
		"knip": "cd .. && knip --config knip.json",
		"test": "cd .. && node --test test/*.test.mjs"
	},
	"devDependencies": {
		"prettier": "^3.9.6"
	}
}
