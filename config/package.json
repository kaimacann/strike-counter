{
	"name": "bridgette-scoreboard",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "astro dev --root .. --config config/astro.config.mjs",
		"build": "astro build --root .. --config config/astro.config.mjs",
		"check": "astro check --root .. --config config/astro.config.mjs --tsconfig config/tsconfig.json",
		"format": "prettier --config .prettierrc.mjs --ignore-path ../.gitignore --ignore-path .prettierignore --write ..",
		"format:check": "prettier --config .prettierrc.mjs --ignore-path ../.gitignore --ignore-path .prettierignore --check ..",
		"lint": "cd .. && eslint --config config/eslint.config.mjs .",
		"knip": "cd .. && knip --config config/knip.json --tsConfig config/tsconfig.json",
		"test": "cd .. && node --test test/*.test.mjs"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.4",
		"@terra-symposium/standards-error-boundaries": "^0.1.2",
		"astro": "^7.2.8",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@eslint/js": "^9",
		"@headlessui/tailwindcss": "^0.2.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.18",
		"autoprefixer": "^10.5.4",
		"eslint": "^9",
		"eslint-plugin-astro": "^1.3.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^16.4.0",
		"knip": "^6.33.0",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^1.1.1",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-scrim-gradients": "^0.4.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8",
		"vidstack": "^0.4.5"
	}
}
