{
	"$schema": "../node_modules/@terra-symposium/quality/quality.schema.json",
	"root": "..",
	"sourceRoots": ["src", "test"],
	"extensions": [".astro", ".js", ".jsx", ".mjs", ".ts", ".tsx"],
	"aliases": { "@components/": "src/components/", "@lib/": "src/lib/", "@ui/": "src/components/ui/", "@utils": "src/lib/utils" },
	"tsconfig": "config/tsconfig.json",
	"tools": { "eslint": "eslint", "knip": "node_modules/.bin/knip", "prettier": "prettier", "tsc": "tsc" },
	"autofix": { "document": false, "knip": false, "lint": false, "name": true },
	"singleUse": { "skippedDirectories": ["src/components", "src/lib/neon.ts"] },
	"documentation": { "required": { "exportedFunctions": true } },
	"repeatedClasses": { "minimumCount": 3 },
	"regexDedup": { "minimumCount": 2 }
}
