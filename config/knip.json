{
	"workspaces": {
		".": {
			"entry": ["src/pages/**/*.astro", "tests/**/*.mjs", "scripts/quality-runner.mjs", "prettier.config.cjs"],
			"paths": {
				"@components/*": ["src/components/*"],
				"@lib/*": ["src/lib/*"],
				"@ui/*": ["src/components/ui/*"],
				"@utils": ["src/lib/utils.ts"]
			}
		},
		"config": { "entry": ["*.config.mjs", "zed/*.mjs"] }
	}
}
